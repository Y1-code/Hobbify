@* תגית סטטוס: עיגול צבעוני עם אייקון, ולידו טקסט. למשל "אושר" בירוק או "בבדיקה" בצהוב.
   רכיב משותף: משתמשים בו בדף הבית ובדפים של ההורה, מנהל המתנס ומנהל המערכת.
   הדף מעביר רק את שם הסטטוס, והרכיב קובע את הצבע, האייקון והטקסט. כך הם זהים בכל האתר.
   שימוש: <StatusBadge Status="approved" /> *@
<span class="status st-@color">
    <span class="st-ic"><Icon Name="@icon" /></span>
    @text
</span>

@code {
    // שם הסטטוס באנגלית: pending, approved, rejected, cancelled, active, full, waiting, blocked
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    private string color = "gray";
    private string icon = "ban";
    private string text = "";

    // רצה בכל פעם שהרכיב מקבל פרמטרים, וקובעת את הצבע, האייקון והטקסט לפי הסטטוס
    protected override void OnParametersSet()
    {
        if (Status == "pending")
        {
            color = "yellow"; icon = "clock"; text = "בבדיקה";
        }
        else if (Status == "waiting")
        {
            color = "yellow"; icon = "clock"; text = "ממתין לאישור";
        }
        else if (Status == "approved")
        {
            color = "green"; icon = "check"; text = "אושר";
        }
        else if (Status == "active")
        {
            color = "green"; icon = "check"; text = "פעיל";
        }
        else if (Status == "rejected")
        {
            color = "red"; icon = "x"; text = "נדחה";
        }
        else if (Status == "full")
        {
            color = "red"; icon = "x"; text = "החוג מלא";
        }
        else if (Status == "blocked")
        {
            color = "red"; icon = "ban"; text = "חסום";
        }
        else
        {
            color = "gray"; icon = "ban"; text = "בוטל";
        }
    }
}
