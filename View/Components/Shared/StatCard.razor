@* נוסף בשלב 9. כרטיס נתון בלוח ניהול: אייקון צבעוני, מספר גדול, כותרת והערה קטנה.
   רכיב משותף: משתמשים בו בדף הראשי של ההורה, של מנהל המתנס ושל מנהל המערכת.
   שימוש: <StatCard Icon="inbox" Color="yellow" Number="4" Title="בקשות ממתינות" Note="הוותיקה מלפני 5 ימים" /> *@
<div class="hb-card stat h-100">
    <span class="icon-tile stat-icon t-@Color"><Icon Name="@Icon" /></span>
    <span class="num">@Number</span>
    <b>@Title</b>
    @if (!string.IsNullOrEmpty(Note))
    {
        <span class="muted small">@Note</span>
    }
</div>

@code {
    // שם האייקון, למשל grid, inbox, users
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    // צבע האייקון: primary, accent, green או yellow
    [Parameter] public string Color { get; set; } = "primary";

    // המספר הגדול. מחרוזת, כדי שאפשר יהיה לכתוב גם "1,284"
    [Parameter, EditorRequired] public string Number { get; set; } = "";

    // מה המספר מתאר
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    // הערה קטנה מתחת (לא חובה)
    [Parameter] public string? Note { get; set; }
}
