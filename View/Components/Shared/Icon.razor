@* אייקון קטן מתוך הספרייה Lucide (רישיון ISC, מותר לשימוש חופשי).
   שימוש: <Icon Name="search" />
   כדי להוסיף אייקון, מוסיפים שורה למילון למטה. *@

@((MarkupString)Svg)

@code {
    // שם האייקון, למשל "search" או "map-pin"
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private string Svg =>
        "<svg class='icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' " +
        "stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>" +
        (Paths.TryGetValue(Name, out var path) ? path : "") +
        "</svg>";

    // הקווים של כל אייקון, כמו שהם מופיעים ב-Lucide
    private static readonly Dictionary<string, string> Paths = new()
    {
        ["search"] = "<circle cx='11' cy='11' r='8'/><path d='m21 21-4.3-4.3'/>",
        ["map-pin"] = "<path d='M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0'/><circle cx='12' cy='10' r='3'/>",
        ["sparkles"] = "<path d='M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z'/><path d='M20 3v4'/><path d='M22 5h-4'/><path d='M4 17v2'/><path d='M5 18H3'/>",
        ["info"] = "<circle cx='12' cy='12' r='10'/><path d='M12 16v-4'/><path d='M12 8h.01'/>",
        ["circle-alert"] = "<circle cx='12' cy='12' r='10'/><line x1='12' x2='12' y1='8' y2='12'/><line x1='12' x2='12.01' y1='16' y2='16'/>",
    };
}