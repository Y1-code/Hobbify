@*
    אייקון קטן, הציורים עצמם מוגדרים בקובץ העיצוב
    שימוש
        <Icon Name="search" />
    שמות לדוגמה
        search, pin, check, x, clock, bell, user, users, plus, grid, inbox, building, star, edit, ban
*@
<i class="i i-@Name" aria-hidden="true"></i>

@code {
    // שם האייקון, בלי הקידומת
    //     i-
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
