@* נוסף בשלב 9. קיצור דרך: כרטיס שכולו קישור לדף אחר, עם אייקון, כותרת ושורת הסבר.
   רכיב משותף: משתמשים בו בדף הראשי של כל אחד משלושת התפקידים.
   שימוש: <ShortcutCard Href="manager/classes" Icon="grid" Color="green" Title="החוגים שלי" Text="מקומות פנויים ועריכה" /> *@
<a class="hb-card shortcut h-100" href="@Href">
    <span class="icon-tile stat-icon t-@Color"><Icon Name="@Icon" /></span>
    <b>@Title</b>
    <span class="muted small">@Text</span>
</a>

@code {
    // הכתובת של הדף שאליו הכרטיס מוביל
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    // שם האייקון
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    // צבע האייקון: primary, accent, green או yellow
    [Parameter] public string Color { get; set; } = "primary";

    // כותרת הכרטיס
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    // שורת הסבר קצרה
    [Parameter] public string Text { get; set; } = "";
}
