@* נוסף בשלב 4. בשלב 5 נוסף קישור דו כיווני בין השדה למשתנה בדף (Value ו-ValueChanged).
   שדה טופס: תווית ותיבת קלט, עם הסבר קטן מתחת אם צריך.
   שימוש: <Field Id="reg-email" Label="אימייל" Type="email" Dir="ltr" @bind-Value="email" /> *@

<div class="field">
    <label for="@Id">
        @Label
        @if (Required)
        {
            <span class="must">*</span>
        }
    </label>

    @* התיבה מציגה את הערך שקיבלה מהדף. כשהמשתמש משנה אותו ויוצא מהשדה, הערך החדש נשלח בחזרה לדף *@
    <input class="input" id="@Id" type="@Type" dir="@Dir" autocomplete="@AutoComplete"
           value="@Value" @onchange="OnValueChanged" />

    @if (!string.IsNullOrEmpty(Hint))
    {
        <span class="hint">@Hint</span>
    }
</div>

@code {
    // המזהה של התיבה. התווית מתחברת אליה דרך for, וכך לחיצה על התווית מכניסה לשדה.
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    // הטקסט שמעל התיבה
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    // סוג השדה: text, email, password, tel
    [Parameter] public string Type { get; set; } = "text";

    // כיוון הכתיבה. "ltr" לשדות באנגלית כמו אימייל וסיסמה.
    [Parameter] public string Dir { get; set; } = "rtl";

    // הסבר קטן מתחת לתיבה (לא חובה)
    [Parameter] public string? Hint { get; set; }

    // האם להציג כוכבית אדומה של שדה חובה
    [Parameter] public bool Required { get; set; }

    // עוזר לדפדפן להציע מילוי אוטומטי (email, name, tel, current-password, new-password)
    [Parameter] public string? AutoComplete { get; set; }

    // נוסף בשלב 5: הערך שבתיבה.
    // שני הפרמטרים האלה יחד מאפשרים לדף לכתוב @bind-Value="משתנה" ולקבל קישור דו כיווני.
    // דף שלא מעביר אותם, כמו דף ההתחברות, ממשיך לעבוד כמו קודם.
    [Parameter] public string? Value { get; set; }

    // הפעולה של הדף שמקבלת את הערך החדש
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    // נקראת כשהמשתמש שינה את הערך ויצא מהשדה, ומעבירה את הערך החדש לדף
    private Task OnValueChanged(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}