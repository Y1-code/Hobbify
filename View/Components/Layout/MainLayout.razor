@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation

@* המבנה המשותף של כל הדפים: סרגל עליון, ומתחתיו הדף עצמו (@Body).
   מה שכתוב כאן מופיע בכל דף באתר.
   נוסף בשלב 6: הסרגל מציג מי מחובר, ויש בו כפתור התנתקות. *@

<header class="hb-nav">
    <div class="hb-container nav-inner">
        <div class="nav-start">
            <Logo />

            @* NavLink הוא קישור שמסמן את עצמו במחלקה active כשנמצאים בדף שלו *@
            <nav class="nav-links" aria-label="תפריט ראשי">
                <NavLink href="" Match="NavLinkMatch.All">דף הבית</NavLink>
                <a href="#cities">ערים</a>
                <NavLink href="soon">הצטרפות כמתנס</NavLink>
            </nav>
        </div>

        <div class="nav-end">
            @if (Session.IsLoggedIn)
            {
                <span class="user-chip">שלום, @Session.FullName</span>
                <button class="hb-btn hb-btn-secondary hb-btn-sm" type="button" @onclick="Logout">התנתקות</button>
            }
            else
            {
                <span class="user-chip">שלום, אורח</span>
                <a class="hb-btn hb-btn-plain hb-btn-sm" href="register">הרשמה</a>
                <a class="hb-btn hb-btn-primary hb-btn-sm" href="login">התחברות</a>
            }
        </div>
    </div>
</header>

@Body

<div id="blazor-error-ui" data-nosnippet>
    אירעה שגיאה לא צפויה.
    <a href="." class="reload">רענון</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // נרשמים לאירוע של השירות: "כשהמשתמש המחובר משתנה, תפעיל את OnSessionChanged"
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
    }

    // מבקשת מהסרגל לצייר את עצמו מחדש.
    // InvokeAsync מוודאת שהעדכון רץ בצורה בטוחה, גם כשהאירוע הופעל מתוך רכיב אחר (דף ההתחברות)
    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("");
    }

    // כשהרכיב נסגר, מבטלים את ההרשמה לאירוע. אחרת השירות ימשיך לקרוא לרכיב שכבר לא קיים
    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }
}
