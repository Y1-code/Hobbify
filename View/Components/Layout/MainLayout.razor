@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation

@*
    המבנה המשותף של כל הדפים: סרגל עליון, ומתחתיו הדף עצמו
    מה שכתוב כאן מופיע בכל דף באתר
    הסרגל מציג מי מחובר, ויש בו כפתור התנתקות
    התפריט משתנה לפי התפקיד, ובתחתית כל דף יש קישור למפת האתר
*@

<header class="hb-nav">
    <div class="hb-container nav-inner">
        <div class="nav-start">
            <Logo />

            @*
                התפריט מציג רק את האפשרויות שמתאימות לתפקיד של המשתמש המחובר
                NavLink
                    קישור שמסמן את עצמו כפעיל כשנמצאים בדף שלו
            *@
            <nav class="nav-links" aria-label="תפריט ראשי">
                @if (Session.Role == Roles.Parent)
                {
                    <NavLink href="" Match="NavLinkMatch.All">דף הבית</NavLink>
                    <NavLink href="parent" Match="NavLinkMatch.All">האזור שלי</NavLink>
                    <NavLink href="parent/requests">הבקשות שלי</NavLink>
                }
                else if (Session.Role == Roles.Manager)
                {
                    <NavLink href="manager" Match="NavLinkMatch.All">לוח ניהול</NavLink>
                    <NavLink href="manager/classes">החוגים שלי</NavLink>
                    <NavLink href="manager/requests">בקשות הרשמה</NavLink>
                }
                else if (Session.Role == Roles.SuperAdmin)
                {
                    <NavLink href="admin" Match="NavLinkMatch.All">לוח ניהול</NavLink>
                    <NavLink href="admin/centers">מתנסים ממתינים</NavLink>
                    <NavLink href="admin/users">משתמשים</NavLink>
                }
                else
                {
                    <NavLink href="" Match="NavLinkMatch.All">דף הבית</NavLink>
                    <a href="#cities">ערים</a>
                    <NavLink href="soon">הצטרפות כמתנס</NavLink>
                }
            </nav>
        </div>

        <div class="nav-end">
            @if (Session.IsLoggedIn)
            {
                <span class="user-chip">שלום, @Session.FullName</span>
                <button class="hb-btn hb-btn-secondary hb-btn-sm" type="button" @onclick="Logout">התנתקות</button>
            }
            else
            {
                <span class="user-chip">שלום, אורח</span>
                <a class="hb-btn hb-btn-plain hb-btn-sm" href="register">הרשמה</a>
                <a class="hb-btn hb-btn-primary hb-btn-sm" href="login">התחברות</a>
            }
        </div>
    </div>
</header>

@Body

<footer class="site-footer">
    <div class="hb-container">
        <span>Hobbify · פרויקט גמר בהנדסת תוכנה</span>
        <a href="pages">מפת האתר</a>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    אירעה שגיאה לא צפויה.
    <a href="." class="reload">רענון</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // נרשמים לאירוע של השירות: כשהמשתמש המחובר משתנה, הסרגל מתעדכן
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
    }

    // מבקשת מהסרגל לצייר את עצמו מחדש
    // InvokeAsync
    //     מבטיחה שהעדכון רץ בצורה בטוחה, גם כשהאירוע הופעל מרכיב אחר
    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("");
    }

    // כשהרכיב נסגר, מבטלים את ההרשמה לאירוע. אחרת השירות ימשיך לקרוא לרכיב שכבר לא קיים
    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }
}
