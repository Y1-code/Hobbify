@page "/register"

<PageTitle>הרשמה · Hobbify</PageTitle>

<main class="auth">
    <div class="sheet">
        <div class="why">
            <Icon Name="info" />
            <span>החשבון מיועד להורים. אחרי ההרשמה אפשר להירשם לחוגים, לשמור מועדפים ולדבר עם עוזר החוגים.</span>
        </div>

        <nav class="tabs" aria-label="התחברות או הרשמה">
            <a href="login">התחברות</a>
            <a href="register" aria-current="page">חשבון חדש להורה</a>
        </nav>

        <form class="sheet-pad stack">
            <Field Id="reg-name" Label="שם מלא" Required="true" AutoComplete="name" />
            <Field Id="reg-email" Label="אימייל" Type="email" Dir="ltr" Required="true" AutoComplete="email" />
            <Field Id="reg-phone" Label="טלפון" Type="tel" Dir="ltr" AutoComplete="tel"
                   Hint="המתנס ישתמש בו כדי ליצור קשר לגבי ההרשמה" />
            <Field Id="reg-password" Label="סיסמה" Type="password" Dir="ltr" Required="true"
                   AutoComplete="new-password" Hint="לפחות 6 תווים" />
            <Field Id="reg-confirm" Label="אימות סיסמה" Type="password" Dir="ltr" Required="true"
                   AutoComplete="new-password" />

            <button class="btn btn-primary btn-lg btn-block" type="button">יצירת חשבון</button>
        </form>

        <div class="foot">
            כבר יש לכם חשבון? <a href="login">להתחברות</a>
        </div>
    </div>
</main>