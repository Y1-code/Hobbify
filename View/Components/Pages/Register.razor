@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net
@using System.Net.Mail
@inject HttpClient Http
@inject NavigationManager Navigation

@*
    rendermode
        הדף מחובר לשרת בחיבור קבוע, וכל לחיצה מפעילה קוד בשרת בלי קוד שרץ בדפדפן
    prerender: false
        הטופס מוצג רק אחרי שהחיבור מוכן, כדי שהקלדה ולחיצות לא ילכו לאיבוד

    הדף לא ניגש לבסיס הנתונים, הוא שולח בקשות לשרת והשרת פונה לבסיס הנתונים
    ההרשמה בשני שלבים
        קריאה: בודקים שהאימייל לא רשום כבר
        כתיבה: שולחים את ההורה החדש והשרת שומר אותו
    אחרי הצלחה מוצגת הודעה עם ספירה לאחור, ואחרי 5 שניות עוברים לדף ההתחברות
*@

<PageTitle>הרשמה · Hobbify</PageTitle>

<main class="auth-bg">
    <div class="hb-card auth-card">
        <span class="app-tile"><img src="@Assets["images/logo.svg"]" alt="" width="40" height="40" /></span>

        <div class="center-text">
            <h1 style="font-size:32px">יצירת חשבון הורה</h1>
            <p class="muted" style="margin-top:6px">חשבון אחד לכל הילדים במשפחה.</p>
        </div>

        @*
            novalidate
                הדפדפן לא בודק את השדות בעצמו, הבדיקה נעשית בקוד שבתחתית הדף
        *@
        <form class="stack" novalidate>
            <Field Id="reg-name" Label="שם מלא" Required="true" AutoComplete="name"
                   Placeholder="לדוגמה: דנה כהן" @bind-Value="fullName" />
            <Field Id="reg-email" Label="אימייל" Type="email" Dir="ltr" Required="true" AutoComplete="email"
                   Placeholder="name@example.com" @bind-Value="email" />
            <Field Id="reg-phone" Label="טלפון" Type="tel" Dir="ltr" AutoComplete="tel" Placeholder="050-0000000"
                   Hint="המתנס ישתמש בו כדי ליצור קשר לגבי ההרשמה" @bind-Value="phone" />
            <Field Id="reg-password" Label="סיסמה" Type="password" Dir="ltr" Required="true"
                   AutoComplete="new-password" Hint="לפחות 6 תווים" @bind-Value="password" />
            <Field Id="reg-confirm" Label="אימות סיסמה" Type="password" Dir="ltr" Required="true"
                   AutoComplete="new-password" @bind-Value="confirmPassword" />

            @* הודעת שגיאה. מוצגת רק כשיש שגיאה *@
            @if (errorMessage != null)
            {
                <div class="banner warn" role="alert">
                    <Icon Name="x" />
                    <span>@errorMessage</span>
                </div>
            }

            @* הודעת הצלחה, עם ספירה לאחור עד המעבר לדף ההתחברות *@
            @if (isRegistered)
            {
                <div class="banner ok" role="status">
                    <Icon Name="check" />
                    <span><b>ההרשמה הצליחה!</b> עוברים לדף ההתחברות בעוד @secondsLeft שניות.</span>
                </div>
            }

            @* הכפתור מושבת בזמן השליחה ואחרי הצלחה, כדי שלא ילחצו פעמיים *@
            <button class="hb-btn hb-btn-primary hb-btn-lg hb-btn-block" type="button"
                    disabled="@(isBusy || isRegistered)" @onclick="RegisterAsync">
                @(isBusy ? "בודקים..." : "יצירת חשבון")
            </button>
        </form>

        <p class="center-text muted small">כבר יש לכם חשבון? <a href="login">התחברות</a></p>
    </div>
</main>

@code {
    // הערכים שהמשתמש הקליד. כל משתנה מקושר לאחד השדות
    private string? fullName;
    private string? email;
    private string? phone;
    private string? password;
    private string? confirmPassword;

    // מצב הדף: הודעת השגיאה, האם בקשה בדרך, האם ההרשמה הצליחה, וכמה שניות נשארו עד המעבר
    private string? errorMessage;
    private bool isBusy;
    private bool isRegistered;
    private int secondsLeft = 5;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        // ----- בדיקות קלט, לפני שפונים לשרת -----
        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email)
            || string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל שדות החובה.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password.Length < 6)
        {
            errorMessage = "הסיסמה צריכה להכיל לפחות 6 תווים.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;
        try
        {
            // שלב 1, קריאה: האם האימייל כבר רשום
            bool emailExists = await Http.GetFromJsonAsync<bool>(
                $"api/users/email-exists?email={Uri.EscapeDataString(email.Trim())}");
            if (emailExists)
            {
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }

            // שלב 2, כתיבה: שמירת ההורה החדש בשרת
            var request = new RegisterRequest
            {
                FullName = fullName.Trim(),
                Email = email.Trim(),
                Phone = string.IsNullOrWhiteSpace(phone) ? null : phone.Trim(),
                Password = password
            };
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users/register", request);

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                // מישהו נרשם עם אותו אימייל בין שלב 1 לשלב 2
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }
        }
        catch (HttpRequestException)
        {
            // השרת לא פועל, או שהכתובת שלו לא נכונה בקובץ
            //     appsettings.json
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
            return;
        }
        finally
        {
            // רץ תמיד, גם אחרי יציאה מוקדמת מהפונקציה, כדי שהכפתור לא יישאר מושבת
            isBusy = false;
        }

        // ----- הצלחה: ספירה לאחור ומעבר לדף ההתחברות -----
        isRegistered = true;
        while (secondsLeft > 0)
        {
            StateHasChanged();
            await Task.Delay(1000);
            secondsLeft--;
        }
        Navigation.NavigateTo("login");
    }
}