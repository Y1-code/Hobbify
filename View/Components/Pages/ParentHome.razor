@page "/parent"
@inherits ProtectedPage

@*
    הדף הראשי של הורה: מה שההורה רואה מיד אחרי ההתחברות
    בדף: תמונת מצב של הבקשות, קיצורי דרך למה שהורה יכול לעשות באתר, והבקשות האחרונות
    דף מוגן, רק משתמש בתפקיד הורה רואה אותו
    שלב עיצובי: הנתונים הם נתוני דוגמה שכתובים בקוד, בלי פנייה לשרת
*@

<PageTitle>האזור שלי · Hobbify</PageTitle>

@* התוכן מוצג רק למי שמורשה להיכנס לדף *@
@if (IsAllowed)
{
    <main>
        <div class="hb-container">
            <PageHead Title="@("שלום, " + Session.FullName)" Subtitle="כל החוגים והבקשות של המשפחה במקום אחד">
                <a class="hb-btn hb-btn-primary" href=""><Icon Name="search" />חיפוש חוג</a>
            </PageHead>

            @*
                תמונת מצב: בטלפון כרטיס בכל שורה, ובמסך רחב שלושה
                row, col
                    מחלקות הרשת של ספריית העיצוב
            *@
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <StatCard Icon="clock" Color="yellow" Number="1" Title="בקשות בבדיקה" Note="רובוטיקה לצעירים" />
                </div>
                <div class="col-12 col-md-4">
                    <StatCard Icon="check" Color="green" Number="3" Title="חוגים שאושרו" Note="2 ילדים רשומים" />
                </div>
                <div class="col-12 col-md-4">
                    <StatCard Icon="heart" Color="primary" Number="4" Title="חוגים במועדפים" Note="נשמרו לאחר כך" />
                </div>
            </div>

            <h2 class="block-title">מה אפשר לעשות</h2>
            <div class="row g-4">
                <div class="col-6 col-lg-3">
                    <ShortcutCard Href="" Icon="search" Color="primary" Title="חיפוש חוג" Text="בחירת עיר, מתנס וחוג" />
                </div>
                <div class="col-6 col-lg-3">
                    <ShortcutCard Href="parent/requests" Icon="inbox" Color="yellow" Title="הבקשות שלי" Text="מעקב אחרי בקשות ההרשמה" />
                </div>
                <div class="col-6 col-lg-3">
                    <ShortcutCard Href="soon" Icon="calendar" Color="green" Title="מערכת שעות" Text="כל החוגים שאושרו, לפי ימים" />
                </div>
                <div class="col-6 col-lg-3">
                    <ShortcutCard Href="soon" Icon="sparkles" Color="accent" Title="הובי" Text="עוזר AI שממליץ על חוגים" />
                </div>
            </div>

            <div class="block-head">
                <h2 class="block-title">הבקשות האחרונות</h2>
                <a class="hb-btn hb-btn-plain hb-btn-sm" href="parent/requests">לכל הבקשות</a>
            </div>
            <div class="hb-card req-card">
                @foreach (RecentRequest request in recentRequests)
                {
                    <div class="req">
                        <div class="req-line">
                            <div class="req-info">
                                <span class="cat cat-@request.Category lg"><Icon Name="@request.Category" /></span>
                                <div>
                                    <b>@request.ClassName</b>
                                    <small>@request.Details</small>
                                </div>
                            </div>
                            <div class="req-act">
                                <StatusBadge Status="@request.Status" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </main>
}

@code {
    // נתוני דוגמה, בשלבים הבאים הבקשות יגיעו מבסיס הנתונים דרך השרת
    // Category
    //     שם הקטגוריה באנגלית, קובע את הצבע והאייקון
    // Status
    //     הסטטוס שמוצג בתגית
    private record RecentRequest(string ClassName, string Category, string Details, string Status);

    private readonly List<RecentRequest> recentRequests = new()
    {
        new RecentRequest("רובוטיקה לצעירים", "science", "מתנס הדקל · עבור יואב (9) · נשלחה 2.11.2026",      "pending"),
        new RecentRequest("כדורסל בנות",      "sport",   "מתנס נווה צדק · עבור נועה (11) · נשלחה 28.10.2026", "approved"),
        new RecentRequest("גיטרה למתחילים",   "music",   "מתנס הדקל · עבור יואב (9) · נשלחה 20.10.2026",     "rejected"),
    };

    // התפקיד שמורשה להיכנס לדף
    protected override string AllowedRole
    {
        get { return Roles.Parent; }
    }
}
