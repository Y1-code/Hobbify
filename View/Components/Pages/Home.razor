@page "/"

@* דף הבית, פתוח לכולם. חמישה חלקים:
   1. כותרת
   2. בחירת עיר: רשימת ערים ומפת ישראל
   3. איך זה עובד, בשלושה צעדים
   4. החוגים המבוקשים
   5. הובי, עוזר ה-AI
   בשלב הזה הדף הוא עיצוב בלבד, עם נתוני דוגמה שכתובים בקוד שבתחתית הדף. *@

<PageTitle>Hobbify · כל החוגים בעיר שלך</PageTitle>

<main>
    <div class="hb-container">

        @* ===== 1. כותרת ===== *@
        <section class="home-hero">
            <h1>כל החוגים בעיר שלך, במקום אחד.</h1>
            <p class="hb-lead">
                Hobbify מרכזת את החוגים של כל המתנסים בישראל על מפה אחת.
                בחרו עיר, מצאו חוג שמתאים לילד, והירשמו בכמה לחיצות.
            </p>
        </section>

        @* ===== 2. בחירת עיר: רשימה מימין, מפה משמאל ===== *@
        <section class="home-top" id="cities" aria-label="בחירת עיר">
            <div class="home-cities">
                <div class="search">
                    <Icon Name="search" />
                    <label class="sr-only" for="city-q">חיפוש עיר</label>
                    <input class="input" id="city-q" placeholder="חיפוש עיר..." />
                </div>

                <div class="city-head">
                    <h2>בחרו עיר</h2>
                    <span class="muted small">7 ערים · 64 מתנסים · מעל 900 חוגים</span>
                </div>

                <ul class="city-grid">
                    @foreach (City city in cities)
                    {
                        <li>
                            <a href="soon">
                                <span>
                                    <b>@city.Name</b>
                                    <small>@city.Centers מתנסים · @city.Classes חוגים</small>
                                </span>
                                <Icon Name="chev-left" />
                            </a>
                        </li>
                    }
                    <li>
                        <a class="add-city" href="soon">
                            <span>
                                <b>העיר שלכם חסרה?</b>
                                <small>מנהלים מתנס? הצטרפו</small>
                            </span>
                            <Icon Name="plus" />
                        </a>
                    </li>
                </ul>
            </div>

            @* מפת ישראל. כל עיר היא סמן, והמיקום שלו נקבע באחוזים מרוחב ומגובה התמונה (X ו-Y) *@
            <div class="hb-card home-map">
                <div class="region-map">
                    <img src="@Assets["images/israel-region.svg"]" alt="מפת ישראל עם הערים שבאתר" width="560" height="760" />
                    <span class="sea-label">הים התיכון</span>
                    @foreach (City city in cities)
                    {
                        <a class="mpin @city.LabelSide" href="soon" style="--x:@city.X%;--y:@city.Y%">
                            <span class="mpin-label">@city.Name</span>
                            <span class="mpin-drop" aria-hidden="true"></span>
                        </a>
                    }
                </div>
                <span class="map-hint"><Icon Name="pin" />לחצו על עיר כדי לראות את המתנסים בה</span>
            </div>
        </section>

        @* ===== 3. איך זה עובד ===== *@
        <section class="section" id="how">
            <div class="center-text" style="margin-bottom:32px">
                <h2 style="font-size:48px">מהמפה להרשמה, בשלושה צעדים</h2>
                <p class="muted" style="font-size:19px;margin-top:8px">בלי לעבור בין אתרים של מתנסים, עלונים וקבוצות וואטסאפ.</p>
            </div>
            <div class="grid-3">
                <div class="hb-card step">
                    <div class="hb-row between">
                        <span class="icon-tile t-primary"><Icon Name="pin" /></span>
                        <span class="num">1</span>
                    </div>
                    <h3>בחרו עיר</h3>
                    <p>לחצו על העיר שלכם במפת ישראל וגלו את כל המתנסים באזור, על מפה אחת.</p>
                </div>
                <div class="hb-card step">
                    <div class="hb-row between">
                        <span class="icon-tile t-accent"><Icon Name="search" /></span>
                        <span class="num">2</span>
                    </div>
                    <h3>מצאו חוג</h3>
                    <p>סננו לפי גיל וקטגוריה, והשוו שעות, מחירים, מקומות פנויים ודירוגים של הורים.</p>
                </div>
                <div class="hb-card step">
                    <div class="hb-row between">
                        <span class="icon-tile t-green"><Icon Name="check" /></span>
                        <span class="num">3</span>
                    </div>
                    <h3>הירשמו</h3>
                    <p>שלחו בקשה בטופס קצר. כשהמתנס מאשר, הפעמון מעדכן אתכם והחוג נכנס למערכת השעות.</p>
                </div>
            </div>
        </section>

        @* ===== 4. החוגים המבוקשים ===== *@
        <section class="section">
            <div class="section-head">
                <div>
                    <h2>הכי מבוקשים בתל אביב השבוע</h2>
                    <p>4 החוגים שקיבלו הכי הרבה בקשות הרשמה</p>
                </div>
                <a class="hb-btn hb-btn-plain" href="soon">לכל החוגים בתל אביב</a>
            </div>
            <div class="grid-4">
                @foreach (PopularClass popular in popularClasses)
                {
                    <article class="hb-card class-card">
                        <div class="ph ph-@popular.Category" role="img" aria-label="@popular.Name">
                            <span class="ph-disc"><Icon Name="@popular.Category" /></span>
                        </div>
                        <div class="cc-body">
                            <span class="cat cat-@popular.Category"><Icon Name="@popular.Category" /></span>
                            <h3><a class="stretched" href="soon">@popular.Name</a></h3>
                            <p class="muted small">@popular.Center · תל אביב</p>
                            <p class="meta"><Icon Name="users" />גילאי @popular.Ages</p>
                            <p class="meta"><Icon Name="clock" />@popular.Times</p>
                            <div class="cc-foot">
                                <span class="price">₪@popular.Price<small>/ חודש</small></span>
                                @if (popular.SpotsLeft > 0)
                                {
                                    <span class="spots">נשארו @popular.SpotsLeft מקומות</span>
                                }
                                else
                                {
                                    <StatusBadge Color="red" Icon="x" Text="החוג מלא" />
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        @* ===== 5. הובי, עוזר ה-AI ===== *@
        <section class="section ai-banner">
            <div class="ai-text">
                <p class="kicker">
                    <img class="sun" src="@Assets["images/logo.svg"]" alt="" width="22" height="22" />
                    הובי · עוזר AI
                </p>
                <h2>ספרו להובי על הילד,<br />וקבלו חוג שמתאים לו.</h2>
                <p>הובי ממליץ רק על חוגים שקיימים בעיר שלכם, ואתם מאשרים כל פעולה.</p>
            </div>
            <div class="ai-demo">
                <div class="ai-preview" aria-label="דוגמה לשיחה עם הובי">
                    <p class="ai-msg me">הבן שלי בן 9, אוהב מדע, פנוי בימי שני ורביעי</p>
                    <div class="ai-msg bot">
                        <span>
                            <b>רובוטיקה לצעירים</b>
                            <span class="muted small" style="display:block">מתנס הדקל · ב׳ ו-ד׳ 16:30</span>
                        </span>
                        <span class="spots">נשארו 3 מקומות</span>
                    </div>
                </div>
                <a class="hb-btn hb-btn-light hb-btn-lg" href="soon">לשיחה עם הובי</a>
            </div>
        </section>

    </div>
</main>

@code {
    // נתוני דוגמה. בשלבים הבאים הערים והחוגים יגיעו מבסיס הנתונים, דרך ה-API.

    // עיר: שם, מספר מתנסים וחוגים, והמיקום שלה במפה באחוזים.
    // LabelSide קובע לאיזה צד נוטה שם העיר במפה ("l", "r" או ריק), כדי ששמות של ערים סמוכות לא יעלו זה על זה.
    private record City(string Name, int Centers, int Classes, double X, double Y, string LabelSide);

    private readonly List<City> cities = new()
    {
        new City("תל אביב", 14, 212, 41.13, 28.89, "l"),
        new City("ירושלים", 12, 186, 55.16, 36.48, ""),
        new City("חיפה",    10, 140, 44.87, 14.07, ""),
        new City("באר שבע",  8,  97, 48.61, 53.03, ""),
        new City("נתניה",    7,  88, 42.53, 24.07, "r"),
        new City("אשדוד",    8,  91, 38.32, 37.51, "l"),
        new City("אילת",     5,  52, 52.36, 93.71, ""),
    };

    // חוג מבוקש. Category הוא שם הקטגוריה באנגלית (science, sport, music, art),
    // והוא קובע גם את הצבע וגם את האייקון של הכרטיס.
    private record PopularClass(string Name, string Category, string Center,
                                string Ages, string Times, int Price, int SpotsLeft);

    private readonly List<PopularClass> popularClasses = new()
    {
        new PopularClass("רובוטיקה לצעירים", "science", "מתנס הדקל",     "8-11",  "ב׳ ו-ד׳ · 16:30-17:30", 220, 3),
        new PopularClass("כדורסל בנות",      "sport",   "מתנס נווה צדק", "9-12",  "א׳ ו-ג׳ · 17:00-18:15", 180, 6),
        new PopularClass("גיטרה למתחילים",   "music",   "מתנס הדקל",     "10-16", "ה׳ · 15:30-16:30",      260, 0),
        new PopularClass("ציור וקרמיקה",     "art",     "מתנס יד אליהו", "6-9",   "ב׳ · 16:00-17:30",      200, 5),
    };
}
